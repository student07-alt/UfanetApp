<Window x:Class="UfanetApp.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уфанет - Абоненты" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Таблица: Абоненты" FontSize="20" FontWeight="Bold" 
                   Foreground="#005B9F" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnUpdate" Content="Обновить" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="btnUpdate_Click"
                    Background="#FFD700" Foreground="#333333" FontWeight="Bold"/>
            <Button x:Name="btnAdd" Content="Добавить" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="btnAdd_Click"
                    Background="#28A745" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="35" 
                    Click="btnDelete_Click"
                    Background="#DC3545" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="dgSubscribers" Grid.Row="2" AutoGenerateColumns="True" 
                  IsReadOnly="True" SelectionMode="Single"
                  AlternatingRowBackground="#F5F5F5" FontSize="13"/>

        <Button x:Name="btnHome" Grid.Row="3" Content="На главную" Width="100" Height="35" 
                HorizontalAlignment="Left" Margin="0,15,0,0" Click="btnHome_Click"
                Background="#6C757D" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>